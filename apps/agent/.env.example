# ── Phase 2 API ──────────────────────────────────────────────────────────────
# URL of the deployed Cloud Run API.
# Replace with your actual Cloud Run service URL.
API_BASE_URL=https://it-help-desk-api-xxxxx-uc.a.run.app

# ── Gemini / Google AI ────────────────────────────────────────────────────────
# Required when running locally WITHOUT Application Default Credentials (ADC).
# Obtain from https://aistudio.google.com/app/apikey
# When deployed to Cloud Run this is NOT needed — use ADC / Workload Identity.
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# ── GCP project (optional — ADK will detect it automatically on GCP) ──────────
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
